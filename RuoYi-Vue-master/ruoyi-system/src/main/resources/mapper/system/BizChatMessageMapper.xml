<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.BizChatMessageMapper">
    
    <resultMap type="BizChatMessage" id="BizChatMessageResult">
        <result property="id"    column="id"    />
        <result property="sessionId"    column="session_id"    />
        <result property="userId"    column="user_id"    />
        <result property="messageRole"    column="message_role"    />
        <result property="messageType"    column="message_type"    />
        <result property="messageContent"    column="message_content"    />
        <result property="sendTime"    column="send_time"    />
        <result property="tokenUsage"    column="token_usage"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectBizChatMessageVo">
        select id, session_id, user_id, message_role, message_type, message_content, send_time, token_usage, create_by, create_time, update_by, update_time, remark, del_flag from biz_chat_message
    </sql>

    <select id="selectBizChatMessageList" parameterType="BizChatMessage" resultMap="BizChatMessageResult">
        <include refid="selectBizChatMessageVo"/>
        <where>  
            <if test="sessionId != null "> and session_id = #{sessionId}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="messageRole != null  and messageRole != ''"> and message_role = #{messageRole}</if>
            <if test="messageType != null "> and message_type = #{messageType}</if>
            <if test="messageContent != null  and messageContent != ''"> and message_content = #{messageContent}</if>
            <if test="sendTime != null "> and send_time = #{sendTime}</if>
            <if test="tokenUsage != null "> and token_usage = #{tokenUsage}</if>
        </where>
    </select>
    
    <select id="selectBizChatMessageById" parameterType="Long" resultMap="BizChatMessageResult">
        <include refid="selectBizChatMessageVo"/>
        where id = #{id}
    </select>

    <insert id="insertBizChatMessage" parameterType="BizChatMessage" useGeneratedKeys="true" keyProperty="id">
        insert into biz_chat_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">session_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="messageRole != null and messageRole != ''">message_role,</if>
            <if test="messageType != null">message_type,</if>
            <if test="messageContent != null and messageContent != ''">message_content,</if>
            <if test="sendTime != null">send_time,</if>
            <if test="tokenUsage != null">token_usage,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">#{sessionId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="messageRole != null and messageRole != ''">#{messageRole},</if>
            <if test="messageType != null">#{messageType},</if>
            <if test="messageContent != null and messageContent != ''">#{messageContent},</if>
            <if test="sendTime != null">#{sendTime},</if>
            <if test="tokenUsage != null">#{tokenUsage},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateBizChatMessage" parameterType="BizChatMessage">
        update biz_chat_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="sessionId != null">session_id = #{sessionId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="messageRole != null and messageRole != ''">message_role = #{messageRole},</if>
            <if test="messageType != null">message_type = #{messageType},</if>
            <if test="messageContent != null and messageContent != ''">message_content = #{messageContent},</if>
            <if test="sendTime != null">send_time = #{sendTime},</if>
            <if test="tokenUsage != null">token_usage = #{tokenUsage},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteBizChatMessageById" parameterType="Long">
        delete from biz_chat_message where id = #{id}
    </delete>

    <delete id="deleteBizChatMessageByIds" parameterType="String">
        delete from biz_chat_message where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>