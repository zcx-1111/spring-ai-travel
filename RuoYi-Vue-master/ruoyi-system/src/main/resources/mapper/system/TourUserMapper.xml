<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.TourUserMapper">

    <resultMap type="TourUser" id="TourUserResult">
        <result property="id"          column="id"           />
        <result property="username"    column="username"     />
        <result property="password"    column="password"     />
        <result property="nickName"    column="nick_name"    />
        <result property="phone"       column="phone"        />
        <result property="avatar"      column="avatar"       />
        <result property="email"       column="email"        />
        <result property="status"      column="status"       />
        <result property="createTime"  column="create_time"  />
        <result property="updateTime"  column="update_time"  />
        <result property="delFlag"     column="del_flag"     />
    </resultMap>

    <!-- 注意：tour_user 表没有 create_by/update_by/remark 字段，SQL中不能引用 -->
    <sql id="selectTourUserVo">
        select id, username, password, nick_name, phone, avatar, email, status, create_time, update_time, del_flag from tour_user
    </sql>

    <select id="selectTourUserList" parameterType="TourUser" resultMap="TourUserResult">
        <include refid="selectTourUserVo"/>
        <where>
            <if test="username != null  and username != ''"> and username like concat('%', #{username}, '%')</if>
            <if test="nickName != null  and nickName != ''"> and nick_name like concat('%', #{nickName}, '%')</if>
            <if test="phone != null  and phone != ''"> and phone = #{phone}</if>
            <if test="email != null  and email != ''"> and email = #{email}</if>
            <if test="status != null "> and status = #{status}</if>
            and del_flag = 0
        </where>
    </select>

    <select id="selectTourUserByUsername" parameterType="String" resultMap="TourUserResult">
        <include refid="selectTourUserVo"/>
        where username = #{username} and del_flag = 0 limit 1
    </select>

    <select id="selectTourUserById" parameterType="Long" resultMap="TourUserResult">
        <include refid="selectTourUserVo"/>
        where id = #{id} and del_flag = 0
    </select>

    <insert id="insertTourUser" parameterType="TourUser" useGeneratedKeys="true" keyProperty="id">
        insert into tour_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="username != null and username != ''">username,</if>
            <if test="password != null and password != ''">password,</if>
            <if test="nickName != null and nickName != ''">nick_name,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="avatar != null and avatar != ''">avatar,</if>
            <if test="email != null and email != ''">email,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            del_flag,
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="username != null and username != ''">#{username},</if>
            <if test="password != null and password != ''">#{password},</if>
            <if test="nickName != null and nickName != ''">#{nickName},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="avatar != null and avatar != ''">#{avatar},</if>
            <if test="email != null and email != ''">#{email},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            0,
         </trim>
    </insert>

    <update id="updateTourUser" parameterType="TourUser">
        update tour_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="username != null and username != ''">username = #{username},</if>
            <if test="password != null and password != ''">password = #{password},</if>
            <if test="nickName != null">nick_name = #{nickName},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="email != null">email = #{email},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteTourUserByIds" parameterType="String">
        update tour_user set del_flag = 1 where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
